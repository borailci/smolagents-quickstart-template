# === For keys from Google AI Studio ===
# LITELLM_MODEL_ID=gemini/gemini-2.5-flash
# LITELLM_API_KEY=google_api_key_here

# === For keys from Open Router ===
# LITELLM_MODEL_ID=openrouter/google/gemini-2.5-flash
# LITELLM_API_KEY=openrouter_api_key_here

# === Agent Workspace Path ===
AGENT_WORKSPACE_PATH=data/agent_workspace

# === Knowledge base pipeline paths ===
# Absolute or workspace-relative paths are accepted.
CODEBASE_ROOT_PATH=data/agent_workspace/sample_codebase
SUB_AGENTS_ROOT_PATH=data/sub_agents_workspace
KNOWLEDGE_BASE_OUTPUT_PATH=data/knowledge_base
TUTORIAL_OUTPUT_PATH=data/tutorials

DEBUG_MODE=true
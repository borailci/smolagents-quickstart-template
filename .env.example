# --- LLM Provider Settings (Vertex AI) ---
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1
# Path to service account JSON (optional, if not using ADC)
# VERTEX_CREDENTIALS=/path/to/credentials.json

# --- Alternative Provider (OpenAI/Anthropic via LiteLLM) ---
# LITELLM_MODEL_ID=gpt-4-turbo
# LITELLM_API_KEY=sk-...

# --- Model Selection (Optional Overrides) ---
# SUPERVISOR_MODEL_ID=vertex_ai/gemini-2.5-pro
# SUB_AGENT_MODEL_ID=vertex_ai/gemini-2.5-flash
# TUTORIAL_MODEL_ID=vertex_ai/gemini-2.5-pro

# --- Project Paths ---
# Absolute path to the local git repository you want to analyze
CODEBASE_ROOT_PATH=/Users/username/Projects/target-repo

# Where to save the Knowledge Base and Tutorials
SUB_AGENTS_ROOT_PATH=./data

# --- Pipeline Settings ---
# RATE_LIMIT_MAX_REQUESTS=30
# MAX_READ_LINES=300

# --- LLM Judge (External API) ---
# URL for Colab-hosted GPT-OSS-20B API (for ./run.sh evaluate --colab)
# LLM_JUDGE_URL=https://your-ngrok-url.ngrok-free.dev
